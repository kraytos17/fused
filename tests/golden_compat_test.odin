// golden_compat_test.odin — revision compat fixtures (T-09).
//
// tests/golden/rev{7,8}.img are committed 1M images with a fixed logical
// tree (see tests/golden/*.list, generated by `make golden`). Each test
// copies its fixture to /dev/shm (fixtures are never mutated), opens it
// through the normal volume path (journal recovery included), and asserts:
// the checker is fully clean, the master rev/features match, and every
// .list line resolves with the right kind/size/target/xattr plus the exact
// embedded file bytes. Mountability through the kernel is covered by
// tests/fuse/test_golden_mount.py.
// Regeneration is deliberate (`make golden`); never regenerate to silence
// a failure — a mismatch means the format drifted (E-02 territory).
// scope: scratch image
#+build linux
package tests

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"
import "core:sys/posix"
import "core:testing"
import "src:fs"
import "src:fuse3"
import "src:mounter"

GOLDEN_KERNEL := "golden kernel payload 0123456789 abcdefghijklmnopqrstuvwxyz\n"
GOLDEN_README := "golden readme\n"
GOLDEN_LONG := "long name content\n"

Golden_Expect :: struct {
	kind:    string, // F, D, L, X
	size:    u64,
	path:    string,
	target:  string, // L
	xname:   string, // X
	xvalue:  string, // X
	content: string, // F: exact bytes
}

// golden_content returns the exact expected bytes for a golden file path
// ("" for non-files). A proc, not a map literal: no init-time allocation,
// nothing to leak.
golden_content :: proc(path: string) -> string {
	switch path {
	case "/Kernel":
		return GOLDEN_KERNEL
	case "/docs/readme.txt":
		return GOLDEN_README
	case "/this_is_a_long_file_name_01.txt":
		return GOLDEN_LONG
	}
	return ""
}

// golden_fixture copies a committed fixture to scratch and returns the
// scratch path. The caller owns nothing (static buffer reuse is fine:
// the path is consumed before the next call).
golden_fixture :: proc(t: ^testing.T, name: string) -> string {
	src, _ := filepath.join({filepath.dir(#file), "golden", name}, context.temp_allocator)
	data, rerr := os.read_entire_file(src, context.temp_allocator)
	testing.expect_value(t, rerr, nil)
	if rerr != nil { return "" }
	dst := fmt.tprintf("/dev/shm/fused_golden_%s", name)
	testing.expect(t, os.write_entire_file(dst, data) == nil, "stage fixture")
	return dst
}

// golden_parse_list parses a .list file (F/D/L/X lines, # comments)
// into expectations. Content bytes come from golden_contents.
golden_parse_list :: proc(t: ^testing.T, rev: string) -> [dynamic]Golden_Expect {
	out := make([dynamic]Golden_Expect, 0, 8)
	lpath, _ := filepath.join({filepath.dir(#file), "golden", rev}, context.temp_allocator)
	raw, rerr := os.read_entire_file(lpath, context.temp_allocator)
	testing.expect_value(t, rerr, nil)
	if rerr != nil { return out }
	it := string(raw)
	for line in strings.split_lines_iterator(&it) {
		l := strings.trim_space(line)
		if len(l) == 0 || l[0] == '#' { continue }
		switch l[0] {
		case 'F':
			// F <size> <path>
			rest := strings.trim_space(l[1:])
			sp := strings.index_byte(rest, ' ')
			testing.expect(t, sp > 0, "F line shape")
			if sp <= 0 { continue }
			size := u64(0)
			for c in rest[:sp] {
				testing.expect(t, c >= '0' && c <= '9', "F size numeric")
				size = size * 10 + u64(c - '0')
			}
			p := strings.trim_space(rest[sp + 1:])
			append(
				&out,
				Golden_Expect{kind = "F", size = size, path = p, content = golden_content(p)},
			)
		case 'D':
			append(&out, Golden_Expect{kind = "D", path = strings.trim_space(l[1:])})
		case 'L':
			// L <path> -> <target>
			rest := strings.trim_space(l[1:])
			arrow := strings.index(rest, " -> ")
			testing.expect(t, arrow > 0, "L line shape")
			if arrow <= 0 { continue }
			append(&out, Golden_Expect{kind = "L", path = rest[:arrow], target = rest[arrow + 4:]})
		case 'X':
			// X <path> <name>=<value>
			rest := strings.trim_space(l[1:])
			sp := strings.index_byte(rest, ' ')
			testing.expect(t, sp > 0, "X line shape")
			if sp <= 0 { continue }
			kv := rest[sp + 1:]
			eq := strings.index_byte(kv, '=')
			testing.expect(t, eq > 0, "X kv shape")
			if eq <= 0 { continue }
			append(
				&out,
				Golden_Expect{kind = "X", path = rest[:sp], xname = kv[:eq], xvalue = kv[eq + 1:]},
			)
		case:
			testing.expectf(t, false, "unknown list line: %q", l)
		}
	}
	return out
}

golden_check_one :: proc(
	t: ^testing.T,
	img, list: string,
	rev_min, rev_max: u8,
	features: fs.Features,
) {
	dst := golden_fixture(t, img)
	if dst == "" { return }
	defer os.remove(dst)

	vol, vok := open_volume_on_fd_open(dst)
	testing.expect(t, vok, "volume opens (recovery runs)")
	if !vok { return }
	defer close_test_volume(&vol)

	testing.expect_value(t, vol.master.rev_min, rev_min)
	testing.expect_value(t, vol.master.rev_max, rev_max)
	testing.expect(t, vol.master.features == features, "features match")

	rep := fs.check_image(&vol)
	defer fs.check_report_destroy(&rep)
	testing.expect_value(t, rep.errors, 0)
	testing.expect_value(t, rep.warnings, 0)
	if rep.errors != 0 || rep.warnings != 0 {
		for &f in rep.findings {
			fmt.println(f.code, f.detail)
		}
		return
	}

	expectations := golden_parse_list(t, list)
	defer delete(expectations)
	for e in expectations {
		res, rerr := fs.resolve_path(&vol, e.path, context.temp_allocator)
		testing.expect_value(t, rerr, fs.FS_Error.None)
		if rerr != .None { continue }
		switch e.kind {
		case "F":
			testing.expect(t, .Directory not_in res.entry.flags, "F not dir")
			testing.expect(t, .Link not_in res.entry.flags, "F not link")
			testing.expect_value(t, res.entry.file_size, e.size)
			if e.content != "" {
				raw, rerr2 := fs.read_chain(
					&vol,
					fs.data_chain_of(res.entry),
					context.temp_allocator,
				)
				testing.expect_value(t, rerr2, fs.FS_Error.None)
				if rerr2 == .None {
					testing.expect_value(t, string(raw[:min(len(raw), int(e.size))]), e.content)
				}
			}
		case "D":
			testing.expect(t, .Directory in res.entry.flags, "D is dir")
		case "L":
			testing.expect(t, .Link in res.entry.flags, "L is link")
			raw, rerr2 := fs.read_chain(&vol, fs.data_chain_of(res.entry), context.temp_allocator)
			testing.expect_value(t, rerr2, fs.FS_Error.None)
			if rerr2 == .None {
				testing.expect_value(
					t,
					string(raw[:min(len(raw), int(res.entry.file_size))]),
					e.target,
				)
			}
		case "X":
			got, found, gerr := fs.xattr_get(&vol, &res.entry, e.xname)
			testing.expect_value(t, gerr, fs.FS_Error.None)
			testing.expect(t, found, "xattr present")
			testing.expect_value(t, string(got), e.xvalue)
			delete(got)
		}
	}
}

// open_volume_on_fd_open opens a scratch image RW (normal path, recovery
// included), mirroring open_volume_on_fd but owning the open itself.
open_volume_on_fd_open :: proc(path: string) -> (fs.Volume, bool) {
	fd, ferr := os.open(path, {.Read, .Write})
	if ferr != nil { return {}, false }
	v, vok := open_volume_on_fd(fd)
	if !vok {
		os.close(fd)
		return {}, false
	}
	return v, true
}

@(test)
test_golden_rev7_compat :: proc(t: ^testing.T) {
	golden_check_one(t, "rev7.img", "rev7.list", 7, 7, {.Uid_Gid})
}

// test_golden_rev7_rewrite_stable — entry rewrites on a rev 7 image must
// not disturb neighboring slots: rev 7 stores 56-byte entries, and a
// full-struct 64-byte persist at a 56-byte stride used to zero the next
// slot's head (T-09). chmod entry 0 then rename the long file, and prove
// /docs and every other entry still resolve with intact bytes.
@(test)
test_golden_rev7_rewrite_stable :: proc(t: ^testing.T) {
	dst := golden_fixture(t, "rev7.img")
	if dst == "" { return }
	defer os.remove(dst)

	vol, vok := open_volume_on_fd_open(dst)
	testing.expect(t, vok, "volume opens")
	if !vok { return }
	fsys := new(mounter.FS)
	mounter.init_fs_for_test(fsys, vol)
	ctx := fuse3.Context {
		uid          = 1000,
		gid          = 1000,
		private_data = fsys,
	}
	fuse3.set_test_context(&ctx)

	testing.expect_value(t, mounter.fused_chmod("/Kernel", posix.mode_t{.IRUSR}, nil), 0)
	testing.expect_value(
		t,
		mounter.fused_rename(
			"/this_is_a_long_file_name_01.txt",
			"/renamed_long_file_name_01.txt",
			0,
		),
		0,
	)
	vol2 := fsys.vol
	mounter.destroy_fs_for_test(fsys)
	free(fsys)

	rep := fs.check_image(&vol2)
	defer fs.check_report_destroy(&rep)
	testing.expect_value(t, rep.errors, 0)
	testing.expect_value(t, rep.warnings, 0)

	want := [3]struct {
		p: string,
		c: string,
	} {
		{"/Kernel", GOLDEN_KERNEL},
		{"/docs/readme.txt", GOLDEN_README},
		{"/renamed_long_file_name_01.txt", GOLDEN_LONG},
	}
	for w in want {
		res, rerr := fs.resolve_path(&vol2, w.p, context.temp_allocator)
		testing.expect_value(t, rerr, fs.FS_Error.None)
		if rerr != .None { continue }
		raw, rerr2 := fs.read_chain(&vol2, fs.data_chain_of(res.entry), context.temp_allocator)
		testing.expect_value(t, rerr2, fs.FS_Error.None)
		if rerr2 == .None {
			testing.expect_value(t, string(raw[:min(len(raw), int(res.entry.file_size))]), w.c)
		}
	}
	_, rerr := fs.resolve_path(&vol2, "/this_is_a_long_file_name_01.txt", context.temp_allocator)
	testing.expect(t, rerr != .None, "old long name gone")
	close_test_volume(&vol2)
}

@(test)
test_golden_rev8_compat :: proc(t: ^testing.T) {
	golden_check_one(t, "rev8.img", "rev8.list", 8, 8, {.Uid_Gid, .XAttr})
}
