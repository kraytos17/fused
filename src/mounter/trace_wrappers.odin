// trace_wrappers.odin — traced FUSE dispatch wrappers (generated by
// tools/gen_trace_wrappers; do not hand-edit, rerun the generator).
// Each traced_* mirrors its fused_* signature exactly, fast-paths to the
// real implementation when tracing is off (single nil check), and otherwise
// records one JSONL event per call. The ops table (build_operations) points
// here; tests keep calling the real fused_* directly and are unaffected.
#+build linux
package mounter

import "base:runtime"
import "core:c"
import "core:fmt"
import "core:sys/posix"
import "core:time"
import "src:fuse3"

traced_create :: proc "c" (path: cstring, mode: posix.mode_t, fi: ^fuse3.File_Info) -> c.int {
	fsys := get_fs()
	context = runtime.default_context()
	if fsys.trace == nil {
		return fused_create(path, mode, fi)
	}
	t0 := time.tick_now()
	rc := fused_create(path, mode, fi)
	trace_record(
		fsys,
		"create",
		string(path),
		i64(rc),
		rc < 0,
		i64(time.duration_nanoseconds(time.tick_diff(t0, time.tick_now()))),
	)
	return rc
}
